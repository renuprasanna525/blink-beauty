  {
    "model": "parlour.review",
    "pk": 1,
    "fields": {
      "section": 1,
      "service_label": "SIGNATURE BALAYAGE & GLOSS",
      "quote": "\"Walking into Blink felt like stepping into a private Parisian atelier. My colorist spent twenty unhurried minutes discussing tone, maintenance, and my skin's undertones before mixing a single formula. The hand-painted balayage blends so seamlessly that two months later it still grows out like silk.\"",
      "customer_name": "Claire Vance",
      "customer_initials": "CV",
      "visited_text": "Visited 2 days ago",
      "likes_count": 14,
      "likes_icon_class": "bi bi-hand-thumbs-up-fill",
      "is_active": true,
      "sort_order": 0,
      "created_at": "2026-11-01T10:07:58.039Z",
      "updated_at": "2026-11-01T10:07:58.039Z"
    }
  },
  {
    "model": "parlour.review",
    "pk": 2,
    "fields": {
      "section": 1,
      "service_label": "BRIDAL GLAM PACKAGE",
      "quote": "\"Our entire bridal party had our hair and makeup created by Blink for my ceremony in Bel Air. Not only was the team calm, poised, and ahead of schedule, but everyone looked like refined, elevated versions of themselves. No heavy mask effect-just radiant, breathable perfection.\"",
      "customer_name": "Helena Rossi",
      "customer_initials": "HR",
